package-as: SoulShardForever
enable-nolib-creation: no

# No externals: Libs/ is committed and ships as is. tools/externals.txt holds the upstreams;
# tools/sync_libs.py bumps a library on purpose.

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md
  - HANDOFF.md
  - .docs
  - media
  - .vscode
  - tools
  - tests
  - .luacheckrc
  - .github
  - CLAUDE.md
  - ARCHITECTURE.md
